# entropyscope environment variables
# Copy to .env and fill in values. Never commit real secrets.
# All AI behavior runs as deterministic local simulation by default — no API keys required.

NODE_ENV=development
DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AGENT_SERVICE_URL=http://localhost:8000
AGENT_SERVICE_URL=http://localhost:8000
ENTROPYSCOPE_SEED=7331

# Optional: plug in a real LLM provider later (documented in docs/guides/llm-integration.md)
# OPENAI_API_KEY={env:OPENAI_API_KEY}
# ANTHROPIC_API_KEY={env:ANTHROPIC_API_KEY}
