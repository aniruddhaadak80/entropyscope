{
  "$schema": "https://biomejs.dev/schemas/1.9/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "style": {
        "noParameterAssign": "off",
        "useExponentiationOperator": "off",
        "noImplicitBoolean": "off",
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noAssignInExpressions": "off",
        "noArrayIndexKey": "off"
      },
      "a11y": {
        "useKeyWithClickEvents": "off",
        "useButtonType": "off",
        "useSemanticElements": "off",
        "noLabelWithoutControl": "off",
        "useAltText": "off",
        "noSvgWithoutTitle": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "files": {
    "ignore": [
      "node_modules",
      ".next",
      "dist",
      "build",
      "out",
      ".turbo",
      "coverage",
      ".vercel",
      "target",
      "__pycache__",
      "packages/seed/data",
      "packages/seed/packs",
      "packages/seed/wiki",
      "packages/seed/catalog",
      "docs/wiki",
      "docs/memos"
    ]
  }
}
